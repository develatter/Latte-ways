{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.codex/ways-guard.sh",
            "statusMessage": "ways guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.codex/ways-guard.sh",
            "statusMessage": "ways guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
