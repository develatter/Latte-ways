{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./.cursor/ways-guard.sh",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "./.cursor/ways-guard.sh",
        "matcher": "Write",
        "timeout": 30,
        "failClosed": true
      }
    ]
  }
}
