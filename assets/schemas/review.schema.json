{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/review-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "reviewer", "verdict", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["pass", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "disposition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "summary": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["open", "fixed", "accepted", "deferred"] }
        }
      }
    }
  }
}
