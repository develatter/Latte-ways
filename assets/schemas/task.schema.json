{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/task-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "dependsOn", "commits"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "title": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "status": { "enum": ["pending", "ready", "active", "review", "completed", "blocked"] },
    "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "commits": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 7 } },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "minLength": 1 }
  }
}
