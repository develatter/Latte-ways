{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harnessVersion", "testCommand"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "testCommand": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultBranch": { "type": "string", "minLength": 1 }
  }
}
