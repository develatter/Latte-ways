{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/reconciliation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "base", "candidate", "target", "codeTreeDigest", "reviewDigest", "dispositions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "base": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "candidate": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "target": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "codeTreeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "outcome", "concepts"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["updated", "confirmed", "implementation-detail", "derived-or-cosmetic", "removed"] },
          "concepts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
