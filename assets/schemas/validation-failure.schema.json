{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ways.dev/schemas/validation-failure-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "attempt", "phase", "inputCommit", "inputTree", "testCommand", "checks", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "phase": { "const": "validate" },
    "inputCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "inputTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "testCommand": { "$ref": "#/$defs/command" },
    "commands": { "$ref": "#/$defs/commands" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity"],
      "properties": {
        "integrity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "testExitCode": { "type": "integer", "minimum": 0 },
        "named": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "enum": ["test", "lint", "typecheck", "build", "e2e"] },
              "status": { "enum": ["passed", "failed", "timed-out", "skipped", "unavailable"] },
              "command": { "$ref": "#/$defs/command" },
              "exitCode": { "type": "integer", "minimum": 0 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "anyOf": [
        { "properties": { "integrity": { "type": "array", "minItems": 1 } }, "required": ["integrity"] },
        { "properties": { "testExitCode": { "type": "integer", "minimum": 1 } }, "required": ["testExitCode"] },
        {
          "properties": {
            "named": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "enum": ["failed", "timed-out", "unavailable"] } }
              }
            }
          },
          "required": ["named"]
        }
      ]
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "test": { "$ref": "#/$defs/command" },
        "lint": { "$ref": "#/$defs/command" },
        "typecheck": { "$ref": "#/$defs/command" },
        "build": { "$ref": "#/$defs/command" },
        "e2e": { "$ref": "#/$defs/command" },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["test", "lint", "typecheck", "build", "e2e"] }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    }
  }
}
