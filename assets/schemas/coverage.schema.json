{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/coverage-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "globs", "classification", "concepts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "globs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "classification": { "enum": ["concept-backed", "implementation-detail", "derived-or-cosmetic"] },
    "concepts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "classification": { "const": "concept-backed" } }, "required": ["classification"] },
      "then": { "properties": { "concepts": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "classification": { "enum": ["implementation-detail", "derived-or-cosmetic"] } }, "required": ["classification"] },
      "then": { "properties": { "concepts": { "type": "array", "maxItems": 0 } } }
    }
  ]
}
