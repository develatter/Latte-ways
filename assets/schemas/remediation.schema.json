{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/remediation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "source", "target", "reason", "evidence", "priorCheckpoint", "attempt", "timestamp"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "source": { "enum": ["review", "validate"] },
    "target": { "enum": ["implement", "decompose", "plan", "specify"] },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/evidence" },
    "priorCheckpoint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "review" } }, "required": ["source"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/reviewEvidence" } } }
    },
    {
      "if": { "properties": { "source": { "const": "validate" } }, "required": ["source"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/validationEvidence" } } }
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "reason", "evidence", "priorCheckpoint", "attempt", "timestamp"],
      "properties": {
        "source": { "enum": ["review", "validate"] },
        "target": { "enum": ["implement", "decompose", "plan", "specify"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "priorCheckpoint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "review" } }, "required": ["source"] },
          "then": { "properties": { "evidence": { "$ref": "#/$defs/reviewEvidence" } } }
        },
        {
          "if": { "properties": { "source": { "const": "validate" } }, "required": ["source"] },
          "then": { "properties": { "evidence": { "$ref": "#/$defs/validationEvidence" } } }
        }
      ]
    },
    "evidence": {
      "oneOf": [
        { "$ref": "#/$defs/reviewEvidence" },
        { "$ref": "#/$defs/validationEvidence" }
      ]
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "review"],
      "properties": {
        "kind": { "const": "review" },
        "review": {
          "allOf": [
            { "$ref": "https://latte-ways.dev/schemas/review-v1.json" },
            { "type": "object", "properties": { "verdict": { "const": "fail" } }, "required": ["verdict"] }
          ]
        }
      }
    },
    "validationEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/legacyValidationEvidence" },
        { "$ref": "#/$defs/recordedValidationEvidence" }
      ]
    },
    "legacyValidationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "failures"],
      "properties": {
        "kind": { "const": "validate" },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "detail"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "recordedValidationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "failureRecord"],
      "properties": {
        "kind": { "const": "validate" },
        "failureRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree", "digest"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
