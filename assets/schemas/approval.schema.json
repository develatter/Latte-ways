{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/approval-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "phase", "gateCommit", "digest", "approvedBy", "approvedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "phase": { "enum": ["intake", "explore", "assess", "specify", "plan", "decompose", "implement", "review", "validate", "reconcile-memory", "close"] },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "gateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" }
  }
}
