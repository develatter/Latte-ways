{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latte-ways.dev/schemas/memory-state-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "watermark"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "watermark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "digest", "reviewDigest"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
