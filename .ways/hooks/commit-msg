#!/usr/bin/env bash
# Managed by latte-ways. Rejects commits that are not traced to an active work.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
if [[ -n "${WAYS_CLI:-}" ]]; then exec node "$WAYS_CLI" hook commit-msg "$1"; fi
if [[ -f dist/cli.js && -f assets/bootstrap/commit-msg ]]; then exec node dist/cli.js hook commit-msg "$1"; fi
exec npx --no-install ways hook commit-msg "$1"
